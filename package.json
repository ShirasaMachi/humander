{
  "name": "dsh-humander",
  "version": "0.5.0",
  "description": "Human-led research meetings, mandatory submissions and reviewed public memory for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./protocol": "./src/protocol.js",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "templates",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.js",
    "check": "node --check src/index.js && npm test",
    "pack:plugin": "npm pack --ignore-scripts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1"
  }
}
